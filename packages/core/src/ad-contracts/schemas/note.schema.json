{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brianharness.app/contracts/v1/note.schema.json",
  "title": "Director output and note (contract-v1)",
  "definitions": {
    "EvidenceId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 24,
      "pattern": "^(?:e[0-9]+|u[0-9]+|a[0-9]+(?:\\.p[0-9]+(?:\\.s[0-9]+)?)?)$"
    },
    "SuggestionMove": {
      "type": "string",
      "enum": [
        "go_deeper",
        "broaden",
        "return_to",
        "clarify",
        "simplify",
        "give_example",
        "check_in",
        "slow_down",
        "other"
      ]
    },
    "DirectorSuggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "move",
        "text"
      ],
      "properties": {
        "move": {
          "type": "string",
          "enum": [
            "go_deeper",
            "broaden",
            "return_to",
            "clarify",
            "simplify",
            "give_example",
            "check_in",
            "slow_down",
            "other"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        }
      }
    },
    "DirectorNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rationale",
        "value",
        "evidence",
        "confidence",
        "expires_after_turns"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 12,
          "pattern": "^n[0-9]+$"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "observation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "suggestion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "move",
            "text"
          ],
          "properties": {
            "move": {
              "type": "string",
              "enum": [
                "go_deeper",
                "broaden",
                "return_to",
                "clarify",
                "simplify",
                "give_example",
                "check_in",
                "slow_down",
                "other"
              ]
            },
            "target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 280
            }
          }
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 24,
            "pattern": "^(?:e[0-9]+|u[0-9]+|a[0-9]+(?:\\.p[0-9]+(?:\\.s[0-9]+)?)?)$"
          },
          "minItems": 1,
          "maxItems": 24
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "expires_after_turns": {
          "const": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "observation"
          ]
        },
        {
          "required": [
            "suggestion"
          ]
        }
      ]
    },
    "ContextUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "hypotheses",
        "changed"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "conf",
              "evidence"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "conf": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 24,
                  "pattern": "^(?:e[0-9]+|u[0-9]+|a[0-9]+(?:\\.p[0-9]+(?:\\.s[0-9]+)?)?)$"
                },
                "minItems": 0,
                "maxItems": 24
              }
            }
          },
          "minItems": 0,
          "maxItems": 5
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 0,
          "maxItems": 8
        }
      }
    },
    "DirectorOutput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "context_update",
            "intent",
            "note",
            "no_note_reason"
          ],
          "properties": {
            "context_update": {
              "$ref": "#/definitions/ContextUpdate"
            },
            "intent": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "note": {
              "$ref": "#/definitions/DirectorNote"
            },
            "no_note_reason": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "context_update",
            "intent",
            "note",
            "no_note_reason"
          ],
          "properties": {
            "context_update": {
              "$ref": "#/definitions/ContextUpdate"
            },
            "intent": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "note": {
              "type": "null"
            },
            "no_note_reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          }
        }
      ]
    },
    "NoteKind": {
      "type": "string",
      "enum": [
        "observation",
        "suggestion",
        "both"
      ]
    },
    "RailCode": {
      "type": "string",
      "enum": [
        "kill_switch",
        "consent",
        "data_validity",
        "evidence_missing",
        "evidence_unknown",
        "schema_invalid",
        "lint_sensor",
        "lint_provenance",
        "lint_answer_first",
        "length_cap",
        "duplicate",
        "leak_breaker"
      ]
    },
    "LeakCode": {
      "type": "string",
      "enum": [
        "sensor",
        "provenance",
        "mind_reading",
        "pivot_first",
        "verbatim",
        "forced_move"
      ]
    }
  },
  "$ref": "#/definitions/DirectorOutput"
}
